{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Authentication.JwtBearer": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AgroTrade",
    "Audience": "AgroTradeApi",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "AutoConfirmEmail": false,
    "AppBaseUrl": "http://localhost:5173"
  },
  "Payments": {
    "//SigningSecret": "Not committed. Set with: dotnet user-secrets set \"Payments:SigningSecret\" \"...\" --project src/AgroTrade.Api",
    "//corridor": "Task 2.4 ships one corridor. Widen only alongside a gateway that settles it.",
    "SupportedCurrencies": [ "USD" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Seed": {
    "AdminEmail": ""
  }
}