<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgroTrade.Domain\AgroTrade.Domain.csproj" />
    <ProjectReference Include="..\AgroTrade.Application\AgroTrade.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transactional email (plan D3): MailKit/SMTP now, a provider API at cloud deploy. -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MailKit drags this in transitively at 10.0.0, which carries two advisories
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pin forward to the first patched build. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastructure hosts ASP.NET Core Identity providers (DataProtectorTokenProvider etc.). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
