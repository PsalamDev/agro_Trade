root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[*.{ts,tsx,js,jsx,json,html,css}]
indent_style = space
indent_size = 2

[*.slnx]
indent_style = space
indent_size = 2